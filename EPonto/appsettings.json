{
  // Segredos NÃO ficam aqui: o repositório é público. Configure por variável de
  // ambiente (no Railway, em Variables) ou com `dotnet user-secrets` no desenvolvimento.
  //   ConnectionStrings__DefaultConnection, ConnectionStrings__HangfireConnection
  //   Jwt__Key (mínimo 32 caracteres)
  //   Cloudinary__CloudName, Cloudinary__ApiKey, Cloudinary__ApiSecret
  //   Email__Remetente, Email__Senha (senha de app do Gmail)
  //   Cors__Origens__0, Cors__Origens__1… (endereços do front)
  "ConnectionStrings": {
    "DefaultConnection": "",
    "HangfireConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "EPontoAPI",
    "Audience": "EPontoClients",
    "ExpirationMinutes": 60
  },
  "Email": {
    "Remetente": "",
    "Senha": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Origens do front liberadas no CORS (no Railway: Cors__Origens__0=https://seu-front)
  "Cors": {
    "Origens": [ "http://localhost:3000", "http://localhost:8080" ]
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  }
}
